# --- Public (browser-visible) -------------------------------------------------

# Where the deployed app lives. Used for copy-link / receipt URLs.
# Public site URL — used for absolute OG/canonical/sitemap URLs. Set to your deployed origin.
NEXT_PUBLIC_APP_URL=https://onelink-mauve-nu.vercel.app

# WalletConnect / Reown project ID. Required for mobile wallet QR connect.
# Get one (free) at https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase project URL + anon key. Without these the app falls back to
# localStorage, which means a payer can NOT load a link the creator made
# from a different browser. Recommended for any real deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Address of the deployed OneLinkCollect contract on Arc Testnet.
# Leave blank for local dev; the app will run in demo mode.
NEXT_PUBLIC_ONELINK_CONTRACT_ADDRESS=

# Platform fee in basis points (50 = 0.5%). CANONICAL fee source: this single
# value is read by BOTH the frontend fee preview AND the Foundry deploy script
# (contracts/script/DeployOneLinkCollect.s.sol), so the fee shown to creators
# always matches on-chain settlement. Set it once, here.
NEXT_PUBLIC_PLATFORM_FEE_BPS=0

# Optional Circle App Kit / provider key. The current bridge + unified-balance
# flows work on testnet without it; populate when graduating to mainnet
# providers that require a key.
NEXT_PUBLIC_KIT_KEY=

# Production safety valve. By default, a production build refuses to start
# without NEXT_PUBLIC_ONELINK_CONTRACT_ADDRESS (so a misconfigured deploy
# can't silently fake payments). Set to "true" to allow demo mode in prod
# (only for previews / hackathon demos).
NEXT_PUBLIC_ALLOW_DEMO=

# --- Server-only (NEVER commit real values) -----------------------------------

# Arc Testnet RPC. Foundry reads this via foundry.toml.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployer EOA private key for `forge script ... --broadcast`. Fund this
# address with Arc Testnet USDC at https://faucet.circle.com.
DEPLOYER_PRIVATE_KEY=

# Optional. Defaults to the deployer if unset.
FEE_RECIPIENT=

# Required only if you want to do server-side Supabase writes from Route
# Handlers (recommended hardening — see supabase/schema.sql).
SUPABASE_SERVICE_ROLE_KEY=
